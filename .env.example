APP_NAME=ChilenosProyección
APP_URL=http://localhost:8010
APP_ENV=local
# Producción: APP_DEBUG=0 y APP_ENV=production
APP_DEBUG=0

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=chilenosproyeccion
DB_USER=root
DB_PASS=

# API key para Hermes (header: X-Api-Key). Usar valor largo aleatorio (≥32 chars) en prod.
HERMES_API_KEY=cambiar-en-produccion-usar-openssl-rand-hex-32

# Cloudflare R2 media (keys: ~/.config/cloudflare/ — never commit secrets)
CF_ACCOUNT_ID=
R2_BUCKET=futbolistas-chilenos
R2_PUBLIC_BASE_URL=https://pub-562268dfdb134ca4beb846a2f8f6db0e.r2.dev
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID_FILE=
R2_SECRET_ACCESS_KEY_FILE=
# Optional later:
CF_ZONE_ID=
CF_API_TOKEN=

# Contacto público (familia Futbolistas Chilenos)
CONTACT_EMAIL=futbolistaschilenoscorfo@gmail.com

# Redes (públicas)
SOCIAL_FACEBOOK=https://www.facebook.com/profile.php?id=61584767852507
SOCIAL_INSTAGRAM=https://www.instagram.com/futbolistas.chilenos/

# Analytics / ads (solo IDs públicos en HTML; JWT Clarity Export en ~/.config/clarity/)
ADSENSE_CLIENT_ID=ca-pub-9876535709659512
CLARITY_PROJECT_ID=AVgYQzF1Q6aDdBCEmRNkUA
